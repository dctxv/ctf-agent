// kdbx_crack_fast.c - fast KeePass KDBX 2/3 (AES-KDF) master password cracker
// Build: gcc -O3 -march=native -fopenmp kdbx_crack_fast.c -lcrypto -o kdbx_crack_fast
// Usage: ./kdbx_crack_fast <db.kdbx> <wordlist> [rules.rule]
// Supports a subset of hashcat rule syntax (sufficient for best66/best64 style files).
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <omp.h>
#include <openssl/aes.h>
#include <openssl/sha.h>

#define MAXCAND 256

static unsigned char MASTER_SEED[32], TRANSFORM_SEED[32], IV[16], STREAM_START[32];
static unsigned char CT[32];
static uint64_t ROUNDS = 1;

static void die(const char *m) { fprintf(stderr, "[-] %s\n", m); exit(1); }

static uint32_t rd32(const unsigned char *p) { return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24; }
static uint64_t rd64(const unsigned char *p) { uint64_t v = 0; for (int i = 7; i >= 0; i--) v = v << 8 | p[i]; return v; }

static void parse_kdbx(const char *path) {
    FILE *f = fopen(path, "rb");
    if (!f) die("cannot open db");
    unsigned char hdr[4096];
    size_t n = fread(hdr, 1, 12, f);
    if (n < 12) die("short file");
    if (rd32(hdr) != 0x9AA2D903 || rd32(hdr + 4) != 0xB54BFB67) die("not a kdbx file");
    uint32_t ver = rd32(hdr + 8);
    if ((ver >> 16) != 3 && (ver >> 16) != 2) fprintf(stderr, "[!] version 0x%08x (expected 3.x)\n", ver);
    int have[16] = {0};
    for (;;) {
        unsigned char fh[3];
        if (fread(fh, 1, 3, f) != 3) die("bad header");
        int fid = fh[0];
        size_t sz = fh[1] | fh[2] << 8;
        unsigned char *buf = malloc(sz ? sz : 1);
        if (fread(buf, 1, sz, f) != sz) die("bad header field");
        if (fid == 0) { free(buf); break; }
        switch (fid) {
            case 4: memcpy(MASTER_SEED, buf, 32); have[4] = 1; break;
            case 5: memcpy(TRANSFORM_SEED, buf, 32); have[5] = 1; break;
            case 6: ROUNDS = rd64(buf); have[6] = 1; break;
            case 7: memcpy(IV, buf, 16); have[7] = 1; break;
            case 9: memcpy(STREAM_START, buf, 32); have[9] = 1; break;
            default: break;
        }
        free(buf);
    }
    if (fread(CT, 1, 32, f) != 32) die("short ciphertext");
    fclose(f);
    if (!have[4] || !have[5] || !have[6] || !have[7] || !have[9]) die("missing header fields");
    fprintf(stderr, "[*] kdbx version 0x%08x rounds=%llu\n", ver, (unsigned long long)ROUNDS);
}

/* ---------- rule engine ---------- */
typedef struct { char op; char a, b, c; int n; } OP;
typedef struct { OP *ops; int nops; char *text; int len; } RULE;

static int hexval(char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }

static RULE *load_rules(const char *path, int *nrules) {
    FILE *f = fopen(path, "r");
    if (!f) die("cannot open rule file");
    RULE *rules = calloc(4096, sizeof(RULE));
    int cap = 4096, cnt = 0;
    char line[MAXCAND * 2];
    while (fgets(line, sizeof line, f)) {
        char *s = line;
        while (*s == ' ' || *s == '\t') s++;
        if (!*s || *s == '#' || *s == '\n' || *s == '\r') continue;
        if (cnt >= cap) { cap *= 2; rules = realloc(rules, cap * sizeof(RULE)); }
        RULE *r = &rules[cnt];
        r->ops = calloc(64, sizeof(OP));
        r->nops = 0;
        char *tok = strtok(s, " \t\r\n");
        while (tok && r->nops < 63) {
            OP o = {0};
            int unsupported = 0;
            o.op = tok[0];
            switch (o.op) {
                case ':': case 'l': case 'u': case 'c': case 'C': case 'r': case 'd': case 'f':
                case '[': case ']': case '{': case '}': case 't': case 'q': case 'k': case 'K':
                case 'M': case '4': case '6': case 'E':
                    break;
                case '$': case '^': o.a = tok[1]; break;
                case 's': o.a = tok[1]; o.b = tok[2]; break;   /* sXY */
                case '@': o.a = tok[1]; break;
                case 'T': case 'D': case 'p': case 'z': case 'Z': case 'L': case 'R':
                case '\'':
                    o.n = atoi(tok + 1);
                    if (o.op == '"' || o.op == '\'') { /* handled below */ }
                    break;
                case 'Y': case '+': case '-': o.n = atoi(tok + 1); break;
                case 'i': o.n = atoi(tok + 1); o.a = tok[2]; break; /* iNX */
                case 'o': o.n = atoi(tok + 1); o.a = tok[2]; break; /* oNX overwrite at N with X */
                case 'x': o.n = atoi(tok + 1); o.a = (char)atoi(tok + 2); break;
                case 'O': o.n = atoi(tok + 1); o.a = (char)atoi(tok + 2); break;
                case '*': o.n = atoi(tok + 1); o.a = (char)atoi(tok + 2); break;
                case '<': case '>': case '_': o.n = atoi(tok + 1); break;
                default: unsupported = 1; break;
            }
            if (!unsupported) r->ops[r->nops++] = o;
            tok = strtok(NULL, " \t\r\n");
        }
        if (r->nops == 0) { r->ops[r->nops++] = (OP){.op = ':'}; }
        cnt++;
    }
    fclose(f);
    *nrules = cnt;
    return rules;
}

/* apply one rule to word w (len), result in out; returns new len or -1 if rejected */
static int apply_rule(const RULE *r, const unsigned char *w, int len, unsigned char *out, unsigned char *mem, int *memlen) {
    memcpy(out, w, len);
    int n = len;
    switch (r->ops[0].op) { case 'M': memcpy(mem, out, n); *memlen = n; break; default: break; }
    for (int i = 0; i < r->nops; i++) {
        OP o = r->ops[i];
        int pos;
        switch (o.op) {
            case ':': break;
            case 'l': for (int j = 0; j < n; j++) if (out[j] >= 'A' && out[j] <= 'Z') out[j] += 32; break;
            case 'u': for (int j = 0; j < n; j++) if (out[j] >= 'a' && out[j] <= 'z') out[j] -= 32; break;
            case 'c': for (int j = 0; j < n; j++) out[j] = (j == 0) ? (out[j] >= 'a' && out[j] <= 'z' ? out[j] - 32 : out[j]) : (out[j] >= 'A' && out[j] <= 'Z' ? out[j] + 32 : out[j]); break;
            case 'C': for (int j = 0; j < n; j++) out[j] = (j == 0) ? (out[j] >= 'A' && out[j] <= 'Z' ? out[j] + 32 : out[j]) : (out[j] >= 'a' && out[j] <= 'z' ? out[j] - 32 : out[j]); break;
            case 't': for (int j = 0; j < n; j++) { if (out[j] >= 'a' && out[j] <= 'z') out[j] -= 32; else if (out[j] >= 'A' && out[j] <= 'Z') out[j] += 32; } break;
            case 'r': for (int j = 0, k = n - 1; j < k; j++, k--) { unsigned char t = out[j]; out[j] = out[k]; out[k] = t; } break;
            case 'd': if (n * 2 < MAXCAND) { memcpy(out + n, out, n); n *= 2; } break;
            case 'f': if (n * 2 < MAXCAND) { for (int j = 0; j < n; j++) out[n + j] = out[n - 1 - j]; n *= 2; } break;
            case 'p': for (int k = 0; k < o.n && n * 2 < MAXCAND; k++) { memcpy(out + n, out, n); n *= 2; } break;
            case '[': if (n > 0) { memmove(out, out + 1, --n); } break;
            case ']': if (n > 0) n--; break;
            case '{': if (n > 0) { unsigned char t = out[0]; memmove(out, out + 1, n - 1); out[n - 1] = t; } break;
            case '}': if (n > 0) { unsigned char t = out[n - 1]; memmove(out + 1, out, n - 1); out[0] = t; } break;
            case '$': if (n + 1 < MAXCAND) out[n++] = o.a; break;
            case '^': if (n + 1 < MAXCAND) { memmove(out + 1, out, n); out[0] = o.a; n++; } break;
            case 'T': pos = (o.n >= 0) ? o.n : n + o.n; if (pos >= 0 && pos < n) { if (out[pos] >= 'a' && out[pos] <= 'z') out[pos] -= 32; else if (out[pos] >= 'A' && out[pos] <= 'Z') out[pos] += 32; } break;
            case 'D': pos = o.n; if (pos >= 0 && pos < n) { memmove(out + pos, out + pos + 1, n - pos - 1); n--; } break;
            case '\'': if (o.n < n) n = o.n; break;
            case 's': for (int j = 0; j < n; j++) if (out[j] == (unsigned char)o.a) out[j] = o.b; break;
            case '@': { int k = 0; for (int j = 0; j < n; j++) if (out[j] != (unsigned char)o.a) out[k++] = out[j]; n = k; } break;
            case 'o': if (o.n >= 0 && o.n < n) out[o.n] = o.a; break;
            case 'i': if (n + 1 < MAXCAND && o.n >= 0 && o.n <= n) { memmove(out + o.n + 1, out + o.n, n - o.n); out[o.n] = o.a; n++; } break;
            case '*': { int p1 = o.n, p2 = o.a; if (p1 >= 0 && p1 < n && p2 >= 0 && p2 < n) { unsigned char t = out[p1]; out[p1] = out[p2]; out[p2] = t; } } break;
            case 'z': { int k = o.n; if (k > 0 && n > 0 && n + k < MAXCAND) { for (int j = 0; j < k; j++) out[n + j] = out[0]; n += k; } } break;
            case 'Z': { int k = o.n; if (k > 0 && n > 0 && n + k < MAXCAND) { for (int j = 0; j < k; j++) out[n + j] = out[n - 1]; n += k; } } break;
            case 'k': if (n >= 2) { unsigned char t = out[0]; out[0] = out[1]; out[1] = t; } break;
            case 'K': if (n >= 2) { unsigned char t = out[n - 1]; out[n - 1] = out[n - 2]; out[n - 2] = t; } break;
            case 'q': if (n * 2 < MAXCAND) { for (int j = n - 1; j >= 0; j--) { out[2 * j] = out[j]; out[2 * j + 1] = out[j]; } n *= 2; } break;
            case 'Y': { int k = o.n; if (k > 0 && k <= n && n + k < MAXCAND) { memcpy(out + n, out, k); n += k; } } break;
            case '+': { int k = o.n % (n ? n : 1); if (k > 0 && n > 1) { unsigned char tmp[MAXCAND]; memcpy(tmp, out + k, n - k); memcpy(tmp + n - k, out, k); memcpy(out, tmp, n); } } break;
            case '-': { int k = o.n % (n ? n : 1); if (k > 0 && n > 1) { unsigned char tmp[MAXCAND]; memcpy(tmp, out + n - k, k); memcpy(tmp + k, out, n - k); memcpy(out, tmp, n); } } break;
            case 'M': memcpy(mem, out, n); *memlen = n; break;
            case '4': if (n + *memlen < MAXCAND) { memcpy(out + n, mem, *memlen); n += *memlen; } break;
            case '6': if (n + *memlen < MAXCAND) { memmove(out + *memlen, out, n); memcpy(out, mem, *memlen); n += *memlen; } break;
            case 'O': { int k = o.a; if (*memlen > 0 && k > 0 && o.n >= 0 && o.n + k <= n) memcpy(out + o.n, mem, k); } break;
            case 'x': { int k = o.a; if (*memlen > 0 && o.n >= 0 && o.n + k <= *memlen && n + k < MAXCAND) { memmove(out + o.n + k, out + o.n, n - o.n); memcpy(out + o.n, mem + o.n, k); n += k; } } break;
            case 'E': { int start = 1; for (int j = 0; j < n; j++) { if (start && out[j] >= 'a' && out[j] <= 'z') out[j] -= 32; else if (!start && out[j] >= 'A' && out[j] <= 'Z') out[j] += 32; start = (out[j] == ' ' || out[j] == '-' || out[j] == '_'); } out[0] = (out[0] >= 'a' && out[0] <= 'z') ? out[0] - 32 : out[0]; } break;
            case '<': if (n >= o.n) return -1; break;
            case '>': if (n <= o.n) return -1; break;
            case '_': if (n != o.n) return -1; break;
            default: break;
        }
    }
    return n;
}

/* ---------- core check ---------- */
static int check_pw(const AES_KEY *tkey, const unsigned char *pw, int len) {
    unsigned char h[32], composite[32], transformed[32];
    SHA256(pw, (size_t)len, h);
    SHA256(h, 32, composite);
    memcpy(transformed, composite, 32);
    for (uint64_t i = 0; i < ROUNDS; i++) {
        unsigned char tmp[32];
        AES_encrypt(transformed, tmp, tkey);
        AES_encrypt(transformed + 16, tmp + 16, tkey);
        memcpy(transformed, tmp, 32);
    }
    unsigned char buf[64], master[32], out[32];
    memcpy(buf, MASTER_SEED, 32);
    memcpy(buf + 32, transformed, 32);
    SHA256(buf, 64, master);
    AES_KEY dkey;
    AES_set_decrypt_key(master, 256, &dkey);
    unsigned char iv[16];
    memcpy(iv, IV, 16);
    AES_cbc_encrypt(CT, out, 32, &dkey, iv, AES_DECRYPT);
    return memcmp(out, STREAM_START, 32) == 0;
}

typedef struct { const unsigned char *p; int len; } WORD;

static unsigned char *slurp(const char *path, size_t *size) {
    FILE *f = fopen(path, "rb");
    if (!f) die("cannot open wordlist");
    fseek(f, 0, SEEK_END);
    long sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    unsigned char *buf = malloc(sz + 2);
    if (fread(buf, 1, sz, f) != (size_t)sz) die("read error");
    fclose(f);
    buf[sz] = '\n';
    *size = sz;
    return buf;
}

int main(int argc, char **argv) {
    if (argc < 3) { fprintf(stderr, "usage: %s <db.kdbx> <wordlist> [rules]\n", argv[0]); return 2; }
    parse_kdbx(argv[1]);
    size_t size;
    unsigned char *data = slurp(argv[2], &size);

    /* index word boundaries */
    size_t wcap = 1 << 20, wcnt = 0;
    WORD *words = malloc(wcap * sizeof(WORD));
    for (size_t i = 0, start = 0; i <= size; i++) {
        if (i == size || data[i] == '\n') {
            if (i > start) {
                if (wcnt >= wcap) { wcap *= 2; words = realloc(words, wcap * sizeof(WORD)); }
                words[wcnt].p = data + start;
                words[wcnt].len = (int)(i - start);
                wcnt++;
            }
            start = i + 1;
        }
    }
    fprintf(stderr, "[*] %zu words loaded\n", wcnt);

    int nrules = 0;
    RULE *rules = NULL;
    if (argc >= 4) { rules = load_rules(argv[3], &nrules); fprintf(stderr, "[*] %d rules loaded\n", nrules); }

    volatile int found = 0;
    unsigned char result[MAXCAND];
    int result_len = 0;
    double t0 = omp_get_wtime();
    size_t tested = 0;

    #pragma omp parallel
    {
        AES_KEY tkey;
        AES_set_encrypt_key(TRANSFORM_SEED, 256, &tkey);
        unsigned char cand[MAXCAND], mem[MAXCAND];
        int memlen = 0;
        size_t mycount = 0;
        #pragma omp for schedule(dynamic, 256) nowait
        for (size_t i = 0; i < wcnt; i++) {
            if (found) continue;
            if (!rules) {
                if (words[i].len <= MAXCAND && check_pw(&tkey, words[i].p, words[i].len)) {
                    #pragma omp critical
                    { if (!found) { memcpy(result, words[i].p, words[i].len); result_len = words[i].len; found = 1; } }
                }
                mycount++;
            } else {
                for (int r = 0; r < nrules && !found; r++) {
                    int n = apply_rule(&rules[r], words[i].p, words[i].len, cand, mem, &memlen);
                    if (n < 0) continue;
                    if (check_pw(&tkey, cand, n)) {
                        #pragma omp critical
                        { if (!found) { memcpy(result, cand, n); result_len = n; found = 1; } }
                        break;
                    }
                    mycount++;
                }
            }
        }
        #pragma omp atomic
        tested += mycount;
    }
    double dt = omp_get_wtime() - t0;
    fprintf(stderr, "[*] tested %.0f candidates in %.2fs (%.2f M/s)\n", (double)tested, dt, (double)tested / dt / 1e6);
    if (found) {
        result[result_len] = 0;
        printf("FOUND:%s\n", result);
        printf("[+] master password: %s\n", result);
        return 0;
    }
    printf("[*] no match\n");
    return 1;
}
