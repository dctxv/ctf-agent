# Secrets - never commit real keys
.env
.env.*
!.env.example

# Python caches
__pycache__/
*.pyc
*.log

# Runtime artifacts (shared Docker volume: evidence, loot, sessions, pocs)
/workspace/

# Evaluation subsystem: the SQLite store is the source of truth; the CSV is a
# derived per-experiment export (the repo-root results.csv stays owned by the
# legacy run_eval.py / validate_github.py harness).
*.sqlite
eval/results.sqlite
eval/results.csv
eval/BENCHMARK.md
eval/benchmark.json

# Trusted answer keys for generated challenges (never mounted into the agent)
eval/keys/
# Experience memory store (host-side, namespaced)
eval/memory/

# Imported third-party benchmark data (CTF artifacts + flags; never committed)
benchmarks/
# Derived benchmark manifests (regenerable from the gitignored data via run_import_*)
eval/manifests/benchmarks/
